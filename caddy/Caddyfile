# Сертификат выпускается НЕ Caddy, а certbot'ом на хосте через DNS-01.
#
# Причина: провайдер VPS отбрасывает исходящий трафик к части зарубежных сетей
# после установки TCP-соединения. Проверки HTTP-01 и TLS-ALPN-01 требуют, чтобы
# до сервера достучались несколько точек Let's Encrypt по всему миру, и часть из
# них ответа не получает — валидация не набирает кворум. DNS-01 проверяет только
# TXT-запись в зоне, сеть машины в ней не участвует.
#
# Выпуск и продление — см. DEPLOY.md, раздел 7.
# Каталог /etc/letsencrypt смонтирован в контейнер только на чтение.
#
# Проксируем на nginx фронтенда целиком: маршрутизация /api -> backend
# уже описана в frontend/nginx/default.conf, дублировать её здесь не нужно.

{$DOMAIN} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	tls /etc/letsencrypt/live/{$DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$DOMAIN}/privkey.pem

	reverse_proxy frontend:80
}
