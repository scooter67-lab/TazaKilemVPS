# backend runtime
ENVIRONMENT=production
SECRET_KEY=replace_with_long_random_secret_key
CORS_ORIGINS=http://localhost
RESET_ADMIN_PASSWORD=false

# postgres container credentials (used by db service)
POSTGRES_USER=carpet_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=carpet_journal

# sqlAlchemy URL for backend service
DATABASE_URL=postgresql+psycopg2://carpet_user:replace_with_strong_password@db:5432/carpet_journal
