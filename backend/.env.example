# Скопируйте в .env и подставьте значения. На сервере .env не коммитьте.

# development | production
ENVIRONMENT=development

# SQLite (файл на диске VPS — путь абсолютный, чтобы не потерять при смене cwd):
# DATABASE_URL=sqlite:////var/lib/carpet-journal/app.db
DATABASE_URL=sqlite:///./app.db

# Обязательно смените в production (минимум 32 случайных символа)
SECRET_KEY=change_me

# CORS: через запятую, без пробелов или с пробелами (обрежутся). Для dev можно *
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=*

# Одноразово true, если на production потерян пароль admin (сброс на admin123 при старте), затем false
# RESET_ADMIN_PASSWORD=false
